<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ page import="java.util.*,com.viswagrid.model.Complaint" %>
<% Map<?,?> officer=(Map<?,?>)session.getAttribute("departmentOfficer"); if(officer==null){response.sendRedirect(request.getContextPath()+"/department-login.jsp");return;} List<Complaint> complaints=(List<Complaint>)request.getAttribute("complaints"); %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Department Dashboard | VISWA GRID</title><style>*{box-sizing:border-box}body{margin:0;background:#f3f6f8;font-family:Arial,sans-serif;color:#17212b}.top{background:#125d4e;color:white;padding:22px 5%;display:flex;justify-content:space-between;align-items:center;gap:15px}.top h1{margin:0 0 5px}.top p{margin:0;opacity:.85}.logout button{padding:10px 16px;border:1px solid #ffffff88;border-radius:8px;background:transparent;color:white;cursor:pointer}.wrap{max-width:1200px;margin:30px auto;padding:0 20px}.stats{background:white;border-radius:12px;padding:20px;margin-bottom:20px;box-shadow:0 4px 18px #1020300b}.tablebox{overflow:auto;background:white;border-radius:12px;padding:18px;box-shadow:0 4px 18px #1020300b}table{border-collapse:collapse;width:100%;min-width:850px}th,td{text-align:left;padding:13px;border-bottom:1px solid #e7ecef;vertical-align:top}th{color:#53636c;font-size:13px}select,button.update{padding:9px;border:1px solid #cbd5da;border-radius:7px}button.update{background:#14765f;color:white;border:0;cursor:pointer}.status{font-weight:700;color:#14765f}.empty{padding:30px;text-align:center;color:#64727a}</style></head><body>
<header class="top"><div><h1>Department Dashboard</h1><p><%=officer.get("fullName")%> · <%=officer.get("departmentName")%></p></div><form class="logout" method="post" action="<%=request.getContextPath()%>/department-logout"><button>Logout</button></form></header>
<main class="wrap"><section class="stats"><strong><%=complaints==null?0:complaints.size()%></strong> complaints assigned to your department</section><section class="tablebox"><h2>Assigned Complaints</h2>
<% if("1".equals(request.getParameter("updated"))){ %><p class="status">Complaint status updated successfully.</p><% } %>
<% if(complaints==null||complaints.isEmpty()){ %><div class="empty">No complaints have been assigned to your department yet.</div><% }else{ %><table><thead><tr><th>ID</th><th>Issue</th><th>Citizen</th><th>Location</th><th>Status</th><th>Update status</th></tr></thead><tbody>
<% for(Complaint c:complaints){ %><tr><td>#<%=c.getComplaintId()%></td><td><strong><%=c.getIssueTitle()%></strong><br><%=c.getDescription()==null?"":c.getDescription()%><br><small><%=c.getCategory()%></small></td><td><%=c.getCitizenName()%></td><td><%=c.getAddress()%>, <%=c.getCity()%> - <%=c.getPincode()%></td><td><span class="status"><%=c.getStatus()%></span></td><td><form method="post" action="<%=request.getContextPath()%>/department-update-status"><input type="hidden" name="complaintId" value="<%=c.getComplaintId()%>"><select name="status"><option value="IN_PROGRESS" <%= "IN_PROGRESS".equals(c.getStatus())?"selected":"" %>>In Progress</option><option value="RESOLVED" <%= "RESOLVED".equals(c.getStatus())?"selected":"" %>>Resolved</option><option value="REJECTED" <%= "REJECTED".equals(c.getStatus())?"selected":"" %>>Rejected</option></select> <button class="update" type="submit">Save</button></form></td></tr><% } %>
</tbody></table><% } %></section></main></body></html>
