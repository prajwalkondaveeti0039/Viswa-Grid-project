<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Department Login | VISWA GRID</title>
<style>*{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;background:#f3f6f8;font-family:Arial,sans-serif;color:#17212b}.card{width:min(420px,92vw);background:white;padding:36px;border-radius:18px;box-shadow:0 16px 45px #17212b18}h1{margin:0 0 8px;color:#126b58}.muted{color:#687782;margin-bottom:26px}label{display:block;font-weight:600;margin:16px 0 7px}input{width:100%;padding:13px;border:1px solid #ccd5da;border-radius:9px;font-size:15px}button{width:100%;margin-top:24px;padding:14px;background:#14765f;color:white;border:0;border-radius:9px;font-weight:700;font-size:15px;cursor:pointer}.error{background:#fff0f0;color:#a52626;padding:11px;border-radius:8px}.back{display:block;margin-top:20px;text-align:center;color:#14765f;text-decoration:none}</style></head><body><main class="card"><h1>Department Portal</h1><p class="muted">Sign in using the account created by your administrator.</p>
<% if("1".equals(request.getParameter("error"))){ %><p class="error">Invalid username or password, or your department account is inactive.</p><% } %>
<form method="post" action="<%=request.getContextPath()%>/department-login"><label>Username</label><input name="username" required autocomplete="username"><label>Password</label><input type="password" name="password" required autocomplete="current-password"><button type="submit">Sign In</button></form><a class="back" href="<%=request.getContextPath()%>/index.html">← Back to website</a></main></body></html>
