<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ page import="java.util.*" %>
<% if(session.getAttribute("admin")==null){response.sendRedirect(request.getContextPath()+"/admin-login.jsp");return;} List<?> departments=(List<?>)request.getAttribute("departments"); List<Map<String,Object>> officers=(List<Map<String,Object>>)request.getAttribute("officers"); %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Manage Department Officers | VISWA GRID</title><style>*{box-sizing:border-box}body{font-family:Arial,sans-serif;background:#f3f6f8;color:#17212b;margin:0}.head{background:#172d3c;color:white;padding:22px 5%}.wrap{max-width:1050px;margin:28px auto;padding:0 18px}.panel{background:white;padding:24px;border-radius:13px;margin-bottom:22px;box-shadow:0 4px 18px #1020300b}label{display:block;margin:13px 0 6px;font-weight:600}input,select{width:100%;padding:12px;border:1px solid #cbd5da;border-radius:8px}button{margin-top:18px;background:#14765f;color:white;border:0;padding:12px 18px;border-radius:8px;cursor:pointer}table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:12px;border-bottom:1px solid #e7ecef}.back{color:white}</style></head><body><header class="head"><h1>Department Officer Management</h1><a class="back" href="<%=request.getContextPath()%>/admin-dashboard">← Admin Dashboard</a></header><main class="wrap"><section class="panel"><h2>Create Officer Account</h2><p>Create a separate login and assign the officer to one active department.</p><form method="post" action="<%=request.getContextPath()%>/admin-officers"><label>Full name</label><input name="fullName" maxlength="100" required><label>Username</label><input name="username" minlength="3" maxlength="50" pattern="[A-Za-z0-9_.-]+" required><label>Temporary password (minimum 8 characters)</label><input type="password" name="password" minlength="8" maxlength="72" required><label>Department</label><select name="departmentId" required><option value="">Select department</option><% if(departments!=null)for(Object obj:departments){com.viswagrid.model.Department d=(com.viswagrid.model.Department)obj;%><option value="<%=d.getDepartmentId()%>"><%=d.getDepartmentName()%></option><% } %></select><button type="submit">Create Officer</button></form></section><section class="panel"><h2>Existing Officers</h2><table><thead><tr><th>Name</th><th>Username</th><th>Department</th><th>Account</th></tr></thead><tbody><% if(officers!=null)for(Map<String,Object> o:officers){%><tr><td><%=o.get("fullName")%></td><td><%=o.get("username")%></td><td><%=o.get("departmentName")%></td><td><%=Boolean.TRUE.equals(o.get("active"))?"Active":"Inactive"%></td></tr><% } %></tbody></table></section></main></body></html>
